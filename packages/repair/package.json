{
  "name": "@reflowpress/repair",
  "version": "1.0.0",
  "private": true,
  "description": "Safe, non-destructive publication repair engine with re-inspection verification for ReflowPress",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "@reflowpress/core": "workspace:*",
    "@reflowpress/epub": "workspace:*",
    "@reflowpress/quality": "workspace:*",
    "@xmldom/xmldom": "^0.9.8",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/yauzl": "^3.4.0",
    "typescript": "^5.5.4"
  }
}
