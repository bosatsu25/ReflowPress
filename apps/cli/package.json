{
  "name": "@reflowpress/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Headless command-line interface for ReflowPress Export Workbench",
  "type": "module",
  "bin": {
    "reflowpress": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"const fs = require('node:fs'); fs.rmSync('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "@reflowpress/core": "workspace:*",
    "@reflowpress/epub": "workspace:*",
    "@reflowpress/export": "workspace:*",
    "@reflowpress/pdf": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4"
  }
}
