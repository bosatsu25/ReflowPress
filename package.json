{
  "name": "reflowpress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, local-first ebook workbench",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json --pretty false",
    "test": "vitest run",
    "test:cli": "vitest run tests/unit/cli.test.ts && playwright test tests/e2e/export-cli.spec.ts",
    "test:version": "node scripts/check-version.js",
    "test:api": "vitest run tests/unit/api-contracts.test.ts",
    "build": "tsc -b && pnpm --filter @reflowpress/desktop build",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual-regression.spec.ts --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "electron": "^33.4.11",
    "eslint": "^10.0.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
