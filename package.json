{
  "name": "reflowpress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Free, local-first ebook workbench",
  "main": "apps/desktop/dist/main/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json --pretty false",
    "test": "vitest run",
    "test:cli": "vitest run tests/unit/cli.test.ts && playwright test tests/e2e/export-cli.spec.ts",
    "test:version": "node scripts/check-version.js",
    "test:api": "vitest run tests/unit/api-contracts.test.ts",
    "bench": "vitest run tests/benchmark",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "build": "tsc -b && pnpm --filter @reflowpress/desktop build",
    "package": "electron-builder build",
    "package:dir": "electron-builder --dir",
    "package:win": "electron-builder --win",
    "package:mac": "electron-builder --mac",
    "package:linux": "electron-builder --linux",
    "test:e2e": "playwright test",
    "test:visual": "node scripts/run-visual-tests.js",
    "test:visual:update": "node scripts/run-visual-tests.js --update-snapshots",
    "smoke:package": "node scripts/smoke-test-package.js",
    "release:checksums": "node scripts/generate-checksums.js",
    "release:check": "pnpm test:version && pnpm test:api && pnpm audit --prod && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm analyze:bundle && pnpm bench && pnpm test:visual"
  },
  "dependencies": {
    "@reflowpress/annotations": "workspace:*",
    "@reflowpress/core": "workspace:*",
    "@reflowpress/device": "workspace:*",
    "@reflowpress/epub": "workspace:*",
    "@reflowpress/export": "workspace:*",
    "@reflowpress/library": "workspace:*",
    "@reflowpress/opds": "workspace:*",
    "@reflowpress/quality": "workspace:*",
    "@reflowpress/reader": "workspace:*",
    "@reflowpress/repair": "workspace:*",
    "@reflowpress/search": "workspace:*",
    "@reflowpress/sync": "workspace:*",
    "@reflowpress/typography": "workspace:*",
    "@xmldom/xmldom": "^0.9.12",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "eslint": "^10.0.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "author": {
    "name": "bosatsu25",
    "email": "bosatsu25@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bosatsu25/ReflowPress.git"
  },
  "desktopName": "org.reflowpress.desktop"
}
